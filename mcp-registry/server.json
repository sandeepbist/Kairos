{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.sandeepbist/kairos",
  "title": "Kairos Task Ledger MCP Server",
  "description": "Approve transcript action items into 12 tools; includes a standalone Postgres task ledger.",
  "version": "1.0.0",
  "websiteUrl": "https://github.com/sandeepbist/Kairos",
  "repository": {
    "url": "https://github.com/sandeepbist/Kairos",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryVersion": "1.0",
      "identifier": "kairos-task-ledger",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "uvx",
      "environmentVariables": [
        {
          "name": "POSTGRES_HOST",
          "description": "PostgreSQL host for the ledger database",
          "required": true
        },
        {
          "name": "POSTGRES_PORT",
          "description": "PostgreSQL port (default 5435 in Kairos deployments)",
          "required": false
        },
        {
          "name": "POSTGRES_DB",
          "description": "Database name (default kairos_db)",
          "required": false
        },
        {
          "name": "POSTGRES_USER",
          "description": "Database user",
          "required": true
        },
        {
          "name": "POSTGRES_PASSWORD",
          "description": "Database password",
          "required": true
        }
      ]
    }
  ]
}
