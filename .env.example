# Kairos Environment Configuration Template
# Copy to .env and fill in values. NEVER commit the real .env.

# ── Core ─────────────────────────────────────────────────────────────
APP_NAME="Kairos Ambient Action Agent"
# development | production | test
APP_ENV=development
DEBUG=true
# false = execute real API calls against connected tools
SANDBOX_MODE=false

# ── Security (REQUIRED in production) ────────────────────────────────
# Operator API key (>= 16 chars). In development, leaving this unset
# disables auth; production refuses to start without it.
API_KEY=
# 44-char Fernet key for the OAuth vault. Generate:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Comma-separated exact origins allowed by CORS (the published frontend URL)
CORS_ORIGINS=http://localhost:3000

# ── Database & Temporal ─────────────────────────────────────────────
POSTGRES_USER=kairos_user
POSTGRES_PASSWORD=kairos_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=kairos_db
TEMPORAL_HOST=localhost:7234
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=kairos-batch-queue

# ── LLM extraction (optional; can also be saved via Settings UI) ────
GOOGLE_API_KEY=
OPENAI_API_KEY=
DEFAULT_MODEL_NAME=gemini-2.5-flash

# ── Connector credentials (optional; can also be saved via Settings UI)
NOTION_API_KEY=
NOTION_DATABASE_ID=
JIRA_API_TOKEN=
JIRA_EMAIL=
JIRA_DOMAIN=
GOOGLE_CALENDAR_ACCESS_TOKEN=
LINEAR_API_KEY=
TODOIST_API_KEY=

# ── GitHub issues (optional; can also be saved via Settings UI) ────
# Fine-grained PAT with Issues: write on your target repository
GITHUB_API_TOKEN=
# Default target as owner/name (can also be set per action in review)
GITHUB_TARGET_REPO=

# ── Confluence pages ────────────────────────────────────────────────
# Reuses the Jira credential by default; override token or set a
# default space key (also settable per action in review)
ATLASSIAN_API_TOKEN=
CONFLUENCE_SPACE_KEY=

# ── Google Tasks (optional; tasks-scoped OAuth token) ──────────────
# Saved via Settings UI; a Google Calendar token with a bundled
# tasks grant also works.
GOOGLE_TASKS_ACCESS_TOKEN=

# ── Asana (optional; can also be saved via Settings UI) ─────────────
# Personal access token from app.asana.com/0/my-apps
ASANA_API_TOKEN=

# ── ClickUp (optional; can also be saved via Settings UI) ──────────
# Personal token from ClickUp settings → Apps; default target list id
CLICKUP_API_TOKEN=
CLICKUP_TARGET_LIST=

# ── Slack Socket Mode bot (optional; no-op without both tokens)
# SLACK_APP_TOKEN: xapp-... (Socket Mode), SLACK_BOT_TOKEN: xoxb-...
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
# Seconds each listen cycle stays connected (default 240 of the 300s cycle)
SLACK_LISTEN_SECONDS=

# ── Gmail ingestion (optional; powers the poller and email drafts)
# OAuth client for token refresh; access token saved via Settings UI
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ── Outbound webhooks (optional) ────────────────────────────────────
# LAN receivers (n8n/Home Assistant on the docker bridge) need this true;
# link-local (cloud metadata) ranges are blocked unconditionally.
WEBHOOK_ALLOW_PRIVATE_URLS=

# ── Key rotation (set only during a rotation; remove after) ────────
# The PREVIOUS ENCRYPTION_KEY; MultiFernet decrypts old rows with it
ENCRYPTION_KEY_PREVIOUS=

# ── Observability (optional) ─────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Frontend (server-side only; never NEXT_PUBLIC) ───────────────────
# Internal URL the Next proxy uses to reach the API
BACKEND_INTERNAL_URL=http://localhost:8000
# Must match backend API_KEY; injected by the proxy, never sent to browsers
KAIROS_API_KEY=
# Public links shown in the footer (optional)
NEXT_PUBLIC_API_DOCS_URL=
NEXT_PUBLIC_TEMPORAL_UI_URL=
